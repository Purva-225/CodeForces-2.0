//TC: O(n) 
//Sc: O(n) due to continuous string space. 

#include<bits/stdc++.h> 
using namespace std; 
 
int main(){
    int t; 
    cin>> t; 
    
    while(t--){
        int n; 
        cin>>n; 
        string s; 
        cin>> s; 
        
        bool Continuous3Cell = false; 
        int TotalcntEmptyCell = 0; 
        
        for(int i = 0; i<n; i++){
            if(s[i] == '.' && i+1 < n && s[i+1] == '.' && i+2 < n && s[i+2] == '.'){
                Continuous3Cell = true;
                break; 
            }
            if(s[i] == '.'){
                TotalcntEmptyCell++; 
            }
        }
        if(Continuous3Cell){ // if it is true then return cells of 2; 
          cout<< 2 << endl; 
        }else{
            cout<<  TotalcntEmptyCell << endl; 
        }
    }
    return 0; 
}
